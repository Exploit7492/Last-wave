<?xml version="1.0" encoding="utf-8"?>
<!-- Modern now-playing widget layout: responsive, polished, hardware-grade aesthetic. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Empty state: no active session or media access needed -->
    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_empty_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_art_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_name"
                android:textColor="@color/widget_on_surface"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/widget_empty_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_description"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active player state -->
    <LinearLayout
        android:id="@+id/widget_content_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Prominent Album Artwork with squircle shape -->
            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/widget_art_placeholder" />

            <!-- Title & Artist Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Unknown track"
                    android:textColor="@color/widget_on_surface"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Unknown artist"
                        android:textColor="@color/widget_on_surface_variant"
                        android:textSize="12.5sp" />

                    <!-- Live Equalizer Animation -->
                    <LinearLayout
                        android:id="@+id/widget_eq_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_eq_icon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/widget_eq_frame_0" />

                        <TextView
                            android:id="@+id/widget_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-light"
                            android:letterSpacing="0.08"
                            android:maxLines="1"
                            android:text="Paused"
                            android:textAllCaps="true"
                            android:textColor="@color/widget_on_surface_variant"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Control Buttons -->
            <LinearLayout
                android:id="@+id/widget_controls_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/widget_circle"
                    android:contentDescription="@string/desc_previous"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_skip_previous" />

                <!-- Hero Action: Circular FAB with vibrant crimson gradient -->
                <ImageButton
                    android:id="@+id/widget_play_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_play_pill"
                    android:contentDescription="@string/desc_play_pause"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_play" />

                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_circle"
                    android:contentDescription="@string/desc_next"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_skip_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress: Sleek accent line along bottom -->
        <LinearLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3.5dp"
                android:max="1000"
                android:maxHeight="3.5dp"
                android:minHeight="3.5dp"
                android:progress="0"
                android:progressBackgroundTint="@color/widget_track"
                android:progressTint="@color/widget_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
